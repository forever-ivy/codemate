{
  "name": "@laf-fe/codemate-cli",
  "version": "1.0.14",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Enterprise-grade AI coding assistant CLI",
  "main": "dist/cli.js",
  "bin": {
    "codemate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run --config vitest.quality.config.ts",
    "test:all": "vitest run",
    "test:quality": "vitest run --config vitest.quality.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:install": "./scripts/test-install.sh",
    "test:platform": "tsx scripts/test-platform.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "ci": "npm run quality:release",
    "ci:quick": "npm run typecheck && npm run format:check",
    "quality:release": "npm run typecheck && npm run format:check && npm run test:quality && npm run build",
    "prepublishOnly": "npm run quality:release",
    "release": "./scripts/release.sh",
    "test:local": "./scripts/test-local.sh"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "agent"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.80",
    "@ai-sdk/openai-compatible": "^2.0.56",
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "ai": "^6.0.218",
    "clipboardy": "^5.1.0",
    "commander": "^14.0.3",
    "defu": "^6.1.4",
    "degit": "^2.8.4",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^17.0.1",
    "nanoid": "^5.1.7",
    "openai": "^6.25.0",
    "pathe": "^2.0.3",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/commander": "^2.12.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.10",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
